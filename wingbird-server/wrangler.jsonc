{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "wingbird",
	"compatibility_date": "2025-08-03",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "./src/index.ts",
	"d1_databases": [
		{
			"binding": "wingbird_db",
			"database_name": "wingbird_db",
			"database_id": "5b78de8a-e1d3-48ed-bcde-d1351e8fe54c",
			"migrations_dir": "./migrations"
		}
	],
	"dev": {
		"ip": "0.0.0.0",
		"port": 5173
	}
}