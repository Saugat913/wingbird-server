{
  "name": "wingbird-server",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply wingbird_db --local",
    "db:migrate:remote": "wrangler d1 migrations apply wingbird_db --remote",
    "env:push": "wrangler secret bulk .prod.vars",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.5.1",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.6.23",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "hono": "^4.12.31"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260921.1",
    "@types/node": "^26.1.1",
    "drizzle-kit": "^0.31.10",
    "wrangler": "^4.110.0"
  }
}